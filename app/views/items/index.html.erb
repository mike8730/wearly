<%= render "shared/header"%>

<div class='main'>
  <%# メインビジュアル %>
  <div class="main-visual-slider">
    <div class="slider-track">
      <% 2.times do %>
        <div class="slide"><%= image_tag 'S__70008841.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008843.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008844_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008845_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008846_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008847_0.jpg', class: 'main-visual-img' %></div>
      <% end %>
    </div>
  </div>

  <%# 商品一覧 %>
  <div class='item-contents'>
    <h2 class='item-contents-title'>
      NEW ARRIVALS
    </h2>

    <ul class='item-lists'>
      <% @items.each do |item| %>
        <% item_color = item.item_colors.first %>

        <%# 画像の URL を決める（最小構成） %>
        <% image_tag_html =
             if item_color&.images&.attached?
               image_tag(item_color.images.first)
             else
               image_tag("no_image.png")
             end %>

        <li class="list">
          <%= link_to item_path(item) do %>
            <div class="item-img-content">
              <%= image_tag_html %>
            </div>
            <p><%= item.name %></p>
            <p><%= number_to_currency(item.price, unit: "¥", precision: 0, format: "%u%n") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/footer" %>