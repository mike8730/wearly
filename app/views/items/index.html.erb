<%= render "shared/header"%>

<div class='main'>
  <%# メインビジュアル %>
  <div class="main-visual-slider">
    <button class="slider-btn left" id="slider-left">＜</button>
    <button class="slider-btn right" id="slider-right">＞</button>
    <div class="slider-track" id="slider-track">
      <% @coordinates.each do |coordinate| %>
        <% if coordinate.image.attached? %>
          <%#= link_to coordinate_path(coordinate) do %>
            <%= image_tag coordinate.image, class: 'main-visual-img' %>
          <%# end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# 商品一覧 %>
  <div class='item-contents'>
    <h2 class='item-contents-title'>
      NEW ARRIVALS
    </h2>

    <ul class='item-lists'>
      <% @items.each do |item| %>
        <% item_color = item.item_colors.first %>

        <%# 画像の URL を決める（最小構成） %>
        <% image_tag_html =
             if item_color&.images&.attached?
               image_tag(item_color.images.first)
             else
               image_tag("no_image.png")
             end %>

        <li class="list">
          <%= link_to item_path(item) do %>
            <div class="item-img-content">
              <%= image_tag_html %>
            </div>
          <% end %>

          <div class="item-info-row">
            <div class="item-info-text">
              <p><%= item.name %></p>
              <p><%= number_to_currency(item.price, unit: "¥", precision: 0, format: "%u%n") %></p>
            </div>
            
            <% if current_user %>
              <button
                class="favorite-btn <%= 'favorited' if current_user.favorited?(item) %>"
                data-item-id="<%= item.id %>"
                data-favorited="<%= current_user.favorited?(item) %>">
                <%= current_user.favorited?(item) ? "♥" : "♡" %>
              </button>
            <% else %>
              <button class="favorite-btn" disabled>
                ♡
              </button>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/footer" %>