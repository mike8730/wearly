<%= render "shared/header"%>

<div class='main'>
  <%# メインビジュアル %>
  <div class="main-visual-slider">
    <div class="slider-track">
      <%# --- スライドさせたい画像6枚を2セット並べます --- %>
      <% 2.times do %>
        <div class="slide"><%= image_tag 'S__70008841.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008843.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008844_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008845_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008846_0.jpg', class: 'main-visual-img' %></div>
        <div class="slide"><%= image_tag 'S__70008847_0.jpg', class: 'main-visual-img' %></div>
      <% end %>
    </div>
  </div>

  <%# 商品一覧 %>
  <div class='item-contents'>
    <h2 class='item-contents-title'>
      NEW ARRIVALS
    </h2>
    <ul class='item-lists'>
      <% @items.each do |item| %>
        <% first_item_color = item.item_colors.detect { |ic| ic.images.attached? } %>
        <% first_variant = item.item_variants.find_by(item_color_id: first_item_color&.id) %>

         <li class="list">
           <%= link_to item_path(item, variant_id: first_variant&.id) do %>
             <div class="item-img-content">
               <% if first_item_color&.images&.attached? %>
                 <%= image_tag first_item_color.images.first.variant(resize_to_limit: [300, 300]) %>
               <% else %>
                 <%= image_tag "no_image.png" %>
               <% end %>
             </div>
             <p><%= item.name %></p>
             <p><%= number_to_currency(item.price) %></p>
           <% end %>
         </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/footer" %>