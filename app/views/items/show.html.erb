<%= render "shared/header" %>

<div class="item-show">

  <div class="item-box-container">

    <!-- 左側：画像パネル -->
    <div class="item-image-panel">

      <% item_color = @item.item_colors.find { |ic| ic.images.attached? } %>

      <div class="main-image-container">
        <% if item_color&.images&.attached? %>
          <%= image_tag item_color.images.first, class: "main-image", id: "main-image" %>
        <% else %>
          <%= image_tag "no_image.png", class: "main-image", id: "main-image" %>
        <% end %>
      </div>

      <!-- サムネイル -->
      <div class="thumbnail-container">
        <% @item.item_colors.each do |ic| %>
          <% if ic.images.attached? %>
            <%= image_tag ic.images.first,
                  class: "thumbnail-image",
                  data: {
                    image: url_for(ic.images.first),
                    color_id: ic.id
                  } %>
          <% end %>
        <% end %>
      </div>

    </div>

    <!-- 右側：商品情報 -->
    <div class="item-details-panel">

      <h1 class="item-name"><%= @item.name %></h1>

      <p class="item-price">
        <%= number_to_currency(@item.price, unit: "¥", precision: 0, format: "%u%n") %>
        <span class="tax-included">税込</span>
      </p>

      <div class="item-description-box">
        <h3 class="description-title">商品説明</h3>
        <p class="description-text"><%= @item.description %></p>
      </div>


      <!-- バリエーション選択 -->
      <div class="item-variants-section">

        <!-- カラー -->
        <div class="variant-group">
          <p class="variant-title">カラー</p>
          <div class="variant-options">
            <% @item.item_colors.each do |ic| %>
              <button class="variant-btn color-btn"
                      data-color-id="<%= ic.id %>">
                <%= ic.color.name %>
              </button>
            <% end %>
          </div>
        </div>

        <!-- サイズ（ユニーク化） -->
        <div class="variant-group">
          <p class="variant-title">サイズ</p>
          <div class="variant-options">
            <% unique_sizes = @item.item_variants.map(&:size).uniq %>
            <% unique_sizes.each do |size| %>
              <button class="variant-btn size-btn"
                      data-size-id="<%= size.id %>">
                <%= size.name %>
              </button>
            <% end %>
          </div>
        </div>

      </div>

      <!-- variant 情報を JS に渡す -->
      <div id="item-variants-data" style="display:none;">
        <%= @item.item_variants.map { |v|
              { id: v.id, color_id: v.item_color_id, size_id: v.size_id, stock: v.stock_quantity }
            }.to_json.html_safe %>
      </div>

      <!-- カートボタン -->
      <%= form_with url: cart_items_path, method: :post do %>
        <%= hidden_field_tag :variant_id, nil, id: "selected-variant-id" %>
        <button type="submit" class="item-red-btn disabled" disabled>カートに入れる</button>
      <% end %>

      <%= link_to "戻る", items_path, class: "back-btn" %>

    </div>

  </div>

</div>

<%= render "shared/footer" %>