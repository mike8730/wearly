<div class="variant-fields">
  <div class="form-row">

    <div class="form-group col-md-4">
      <label>色</label>
      <select name="variant_forms[<%= index %>][color_id]"
              class="form-control">
        <option value="">選択</option>
        <% Color.all.each do |color| %>
          <option value="<%= color.id %>">
            <%= color.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="form-group col-md-4">
      <label>サイズ</label>
      <select name="variant_forms[<%= index %>][size_id]"
              class="form-control">
        <option value="">選択</option>
        <% Size.all.each do |size| %>
          <option value="<%= size.id %>">
            <%= size.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="form-group col-md-2">
      <label>在庫数</label>
      <input type="number"
             name="variant_forms[<%= index %>][stock_quantity]"
             class="form-control">
    </div>

    <div class="form-group col-md-2">
      <label>価格</label>
      <input type="number"
             name="variant_forms[<%= index %>][price]"
             class="form-control">
    </div>

  </div>

  <div class="form-row">
    <div class="form-group col-md-12">
      <label>カラー画像</label>
      <small class="form-text text-muted">
        このカラーに対応する画像をアップロード（複数可）
      </small>

      <input type="file"
             name="variant_forms[<%= index %>][color_images][]"
             multiple
             accept="image/*">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-12 mt-2">
      <button type="button"
              class="remove-variant btn btn-sm btn-danger">
        削除
      </button>
    </div>
  </div>
</div>

