<%= render "shared/header" %>

<div class="order-main">
  <div class="order-container">
    <h2 class="order-title">注文内容の確認</h2>
    
    <% if @order.errors.any? %>
      <div class="alert alert-danger order-errors">
        <% @order.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%# ============================
        注文商品一覧
        ============================ %>
    <% @cart.cart_items.each do |cart_item| %>
      <% variant = cart_item.item_variant %>
      <% item = variant.item %>

      <div class="order-item-section">
        <div class="order-item-image">
          <% if variant&.item_color&.images&.attached? %>
            <%= image_tag variant.item_color.images.first, class: 'order-img' %>
          <% elsif item.item_colors.first&.images&.attached? %>
            <%= image_tag item.item_colors.first.images.first, class: 'order-img' %>
          <% else %>
            <%= image_tag 'item-sample.png', class: 'order-img' %>
          <% end %>
        </div>

        <div class="order-item-details">
          <h3 class="order-item-name"><%= item.name %></h3>

          <div class="order-detail-row">
            <span class="label">単価</span>
            <span class="value"><%= number_to_currency(item.price, unit: "¥", precision: 0, format: "%u%n") %></span>
          </div>

          <div class="order-detail-row">
            <span class="label">個数</span>
            <span class="value"><%= cart_item.quantity %>個</span>
          </div>

          <% if variant %>
            <div class="order-detail-row">
              <span class="label">色</span>
              <span class="value"><%= variant.color.name %></span>
            </div>

            <div class="order-detail-row">
              <span class="label">サイズ</span>
              <span class="value"><%= variant.size.name %></span>
            </div>
          <% end %>

          <div class="order-total-price">
            <span>小計</span>
            <span><%= number_to_currency(item.price * cart_item.quantity, unit: "¥", precision: 0, format: "%u%n") %></span>
          </div>
        </div>
      </div>
    <% end %>

    <%# ============================
        配送先入力フォーム
        ============================ %>
    <div class="order-address-section">
      <h3 class="section-title">配送先入力</h3>

      <%= form_with model: @order_form, url: orders_path, method: :post, local: true, class: 'order-form' do |f| %>

        <%# --- 郵便番号 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">郵便番号</label>
            <span class="indispensable">必須</span>
          </div>
          <%= f.text_field :postal_code, class:"input-default", placeholder:"例）123-4567", maxlength:"8" %>
        </div>

        <%# --- 都道府県 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">都道府県</label>
            <span class="indispensable">必須</span>
          </div>
          <%= f.collection_select(:prefecture_id, Prefecture.all, :id, :name, {}, {class:"select-box"}) %>
        </div>

        <%# --- 市区町村 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">市区町村</label>
            <span class="indispensable">必須</span>
          </div>
          <%= f.text_field :city, class:"input-default", placeholder:"例）横浜市緑区"%>
        </div>

        <%# --- 番地 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">番地</label>
            <span class="indispensable">必須</span>
          </div>
          <%= f.text_field :address, class:"input-default", placeholder:"例）青山1-1-1"%>
        </div>

        <%# --- 建物名 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">建物名</label>
            <span class="form-any">任意</span>
          </div>
          <%= f.text_field :building, class:"input-default", placeholder:"例）〇〇マンション001号"%>
        </div>

        <%# --- 電話番号 --- %>
        <div class="form-group">
          <div class='form-text-wrap'>
            <label class="form-text">電話番号</label>
            <span class="indispensable">必須</span>
          </div>
          <%= f.text_field :phone_number, class:"input-default", placeholder:"例）09012345678", maxlength:"11"%>
        </div>

        <%# ============================
            決済方法の選択
            ============================ %>
        <div class="payment-method-section">
          <h3 class="section-title">支払い方法</h3>

          <div class="payment-method-grid">
            <% Order.payment_methods.keys.each do |method| %>
              <label class="payment-card">
                <%= f.radio_button :payment_method, method, class: "payment-radio" %>

                <div class="payment-card-content">
                  <div class="payment-icon">
                    <%= method.humanize %>
                  </div>

                  <div class="payment-label">
                    <%= t("payment_methods.#{method}") rescue method.humanize %>
                  </div>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# --- 注文確定ボタン --- %>
        <div class="order-submit-wrapper">
          <%= f.submit '注文を確定する', class: 'checkout-btn' %>
        </div>

      <% end %>
    </div>
  </div>
</div>

<%= render "shared/footer" %>