<div class="cart-container">

  <h1 class="cart-title">ショッピングカート</h1>

  <% @cart.cart_items.each do |cart_item| %>
    <%= render "cart_item", cart_item: cart_item %>
  <% end %>

  <div class="cart-total">
    合計金額：¥<%= number_with_delimiter(@cart.total_price) %>
  </div>

  <div class="cart-checkout">
    <%#= link_to "購入手続きへ進む", new_order_path, class: "checkout-btn" %>
    <%= button_to "注文を確定する", orders_path, method: :post,class: "checkout-btn" %>
  </div>

</div>
